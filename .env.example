# AutoFlow ML runtime configuration.
#
# Copy this file to `.env` (`Copy-Item .env.example .env` on Windows) and adapt
# the values for your machine. This application does not use API keys or other
# secrets: it trains models locally. Never commit a real `.env` file to git.

# Where application-managed data lives: uploaded CSVs (uploads/), the runtime
# state file (autoflow_state.json), and the MLflow tracking database
# (mlflow.db) by default. Defaults to the project directory.
#AUTOFLOW_DATA_DIR=./data

# Directory for MLflow artifact storage (training artifacts, logged models).
# Defaults to AUTOFLOW_DATA_DIR/mlruns.
#MLFLOW_ARTIFACT_DIR=./mlruns

# Full MLflow tracking URI override. Leave unset for the default SQLite
# backend (AUTOFLOW_DATA_DIR/mlflow.db). An external server URI such as
# http://mlflow:5000 is supported by MLflow 3.x.
#MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db

# Name of the MLflow Model Registry "active model" registry used to survive
# restarts and to expose registry versions through /predict.
#AUTOFLOW_ACTIVE_MODEL_REGISTRY=autoflow-active-models

# Application log level: DEBUG, INFO (default), WARNING, ERROR.
#LOG_LEVEL=INFO

# MLflow prints an agent-hint banner at startup on some installs; set to 1 to
# silence it (cosmetic only).
#MLFLOW_DISABLE_AGENT_HINT=1
